# Required (no working default - the app will not start without these).
DIAL_ENDPOINT=""
DIAL_API_KEY=""
DIAL_API_VERSION=""
CHAT_MODEL=""
EMBEDDING_MODEL=""
ADMIN_API_TOKEN=""

# Required for Stage 3 (the recording/MCP server refuses to start, and the client
# refuses to send, if unset - fail closed). Not needed just to run the chatbot or
# the admin side.
MCP_API_TOKEN=""

# Everything below is optional: config.py already has a working default for each.
# Leave commented out to use it, or uncomment and set a value to override it.
# (A line like `VAR=` with nothing after the `=` is NOT the same as commented out -
# dotenv sets it to an empty string, which breaks int() parsing. Always comment a
# line out fully to actually leave a variable unset.)

# MAX_ADVANCE_DAYS=90
# MAX_VEHICLES_PER_BOOKING=10
# ADMIN_REQUEST_EXPIRY_MINUTES=60
# ADMIN_NOTIFY_POLL_SECONDS=3
# SQL_BUSY_TIMEOUT_MS=5000

# IANA time zone the facility itself is in (e.g. "Europe/Berlin"). Reservation and
# decision times are stored naive, in this zone - Stage 3 uses it to convert them
# to UTC for the reservation file. Default "UTC" treats them as already UTC.
# FACILITY_TIMEZONE=UTC

# Where the admin REST server listens. Currently unused: admin_cli.py talks to the
# admin agent directly rather than over HTTP, and run_admin_server.py's host/port
# are hardcoded rather than read from this. Kept for a possible future REST-client mode.
# ADMIN_SERVER_URL=http://127.0.0.1:8001

# Where scripts/run_mcp_server.py listens; the recording client talks to it here.
# The bare origin only - no /mcp path (the client adds that itself).
# MCP_SERVER_URL=http://127.0.0.1:8002

# Where approved reservations are appended, one line per vehicle. A relative path
# (the default) is resolved against the project root, regardless of where you run
# commands from - not against the current directory, unlike SQL_DB_PATH.
# MCP_RESERVATIONS_FILE_PATH=data/reservations.txt

# How often the background sweep retries bookings the recording server hasn't
# confirmed yet. Minimum 5.
# MCP_RETRY_INTERVAL_SECONDS=30

# How long the recording client waits for one HTTP call before giving up. Minimum 1.
# MCP_REQUEST_TIMEOUT_SECONDS=5
